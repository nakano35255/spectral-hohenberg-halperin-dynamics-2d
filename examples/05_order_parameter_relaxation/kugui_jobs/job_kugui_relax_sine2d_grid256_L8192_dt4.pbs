#!/bin/bash
#PBS -q F1cpu
#PBS -N shhd05-kugui-relax
#PBS -l select=1:ncpus=128:mpiprocs=128:ompthreads=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

module purge
module load intel/2022.2.1 intel-mpi/2021.7.1

export HEFFTE_ROOT=$HOME/local/heffte-oneapi-fftw
export FFTW_ROOT=$HOME/local/fftw-oneapi
export LD_LIBRARY_PATH=$HEFFTE_ROOT/lib:$FFTW_ROOT/lib:${LD_LIBRARY_PATH:-}
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE
export I_MPI_PIN=0
unset I_MPI_PIN_PROCESSOR_LIST

repo=${REPO_ROOT:-$HOME/spectral-hohenberg-halperin-dynamics-2d}
case_dir=examples/05_order_parameter_relaxation
job_dir=$case_dir/kugui_jobs
work_base=${WORK_BASE:-/work/k0565/k056500/spectral-hohenberg-halperin-dynamics-2d/examples/05_order_parameter_relaxation/raw_data}
run_name=${RUN_NAME:-sine2d_grid256_L8192_dt4_T2400000}
output_root=$work_base/$run_name

offset=$((10#${OFFSET:-${SAMPLE_OFFSET:-0}}))
samples=$((10#${SAMPLES:-16}))
tasks_per_sample=$((10#${TASKS_PER_SAMPLE:-8}))

grid_x=${GRID_X:-256}
grid_y=${GRID_Y:-256}
length_x=${LENGTH_X:-8192}
length_y=${LENGTH_Y:-8192}
dealias=${DEALIAS:-three_halves}
dt=${DT:-4.0}
run_time=${RUN_TIME:-2400000.0}
snapshot_dtout=${SNAPSHOT_DTOUT:-48000.0}
thermo_dtout=${THERMO_DTOUT:-120000.0}
eta=${ETA:-0.12}
mobility=${MOBILITY:-0.12}
zeta=${ZETA:-0.0}
kBT=${KBT:-1.0}
amplitude=${AMPLITUDE:-0.1}
nkx=${NKX:-1}
nky=${NKY:-1}

allocated_tasks=$(wc -l < "$PBS_NODEFILE")
if [ "$offset" -lt 0 ] || [ "$samples" -le 0 ]; then
    echo "invalid run layout: offset=$offset samples=$samples" >&2
    exit 1
fi
if [ "$tasks_per_sample" -le 0 ]; then
    echo "invalid TASKS_PER_SAMPLE=$tasks_per_sample" >&2
    exit 1
fi

active_tasks=$((samples * tasks_per_sample))
if [ "$active_tasks" -gt "$allocated_tasks" ]; then
    echo "active MPI tasks exceed allocation: $active_tasks > $allocated_tasks" >&2
    exit 1
fi

compute_grid_x=$grid_x
case "$dealias" in
    three_halves|3/2) compute_grid_x=$((3 * grid_x / 2)) ;;
    two|2) compute_grid_x=$((2 * grid_x)) ;;
esac
spectral_x=$((compute_grid_x / 2 + 1))
if [ "$tasks_per_sample" -gt "$spectral_x" ]; then
    echo "TASKS_PER_SAMPLE=$tasks_per_sample exceeds spectral x size $spectral_x." >&2
    exit 1
fi

cd "$repo"
mkdir -p "$output_root" "$work_base"

if [ "${BUILD_BEFORE_RUN:-0}" = "1" ]; then
    make -f Makefile.ohtaka clean
    make -f Makefile.ohtaka -j 8 all
fi

python3 "$job_dir/prepare_kugui_inputs.py" \
    --output-root "$output_root" \
    --samples "$samples" \
    --sample-offset "$offset" \
    --grid "$grid_x" "$grid_y" \
    --length "$length_x" "$length_y" \
    --dealias "$dealias" \
    --dt "$dt" \
    --run-time "$run_time" \
    --snapshot-dtout "$snapshot_dtout" \
    --thermo-dtout "$thermo_dtout" \
    --eta "$eta" \
    --mobility "$mobility" \
    --zeta "$zeta" \
    --kBT "$kBT" \
    --order-parameter-amplitude "$amplitude" \
    --nkx "$nkx" \
    --nky "$nky"

echo "PBS_JOBID=${PBS_JOBID:-}"
echo "PBS_NODEFILE=$PBS_NODEFILE"
echo "allocated_tasks=$allocated_tasks samples=$samples tasks_per_sample=$tasks_per_sample active_tasks=$active_tasks"
echo "OFFSET=$offset"
echo "output_root=$output_root"

pids=()
for local_sample in $(seq 0 $((samples - 1))); do
    replica_num=$((offset + local_sample))
    rid=$(printf "%03d" "$replica_num")
    input=$output_root/runs/input_${rid}.script
    stdout=$output_root/logs/stdout_${rid}.log
    stderr=$output_root/logs/stderr_${rid}.log

    (
        echo "run replica ${rid}: ranks=${tasks_per_sample}"
        mpiexec -n "$tasks_per_sample" \
            ./src/out.exe "$input" > "$stdout" 2> "$stderr"
    ) &
    pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
    wait "$pid" || status=1
done

exit "$status"
