#!/bin/bash
#PBS -q F1cpu
#PBS -N shhd05-kugui-relax
#PBS -l select=1:ncpus=128:mpiprocs=128:ompthreads=1
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

module purge
module load intel/2022.2.1 intel-mpi/2021.7.1

export HEFFTE_ROOT=$HOME/local/heffte-oneapi-fftw
export FFTW_ROOT=$HOME/local/fftw-oneapi
export LD_LIBRARY_PATH=$HEFFTE_ROOT/lib:$FFTW_ROOT/lib:${LD_LIBRARY_PATH:-}
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE
export I_MPI_PIN=1
export I_MPI_PIN_DOMAIN=core

repo=${REPO_ROOT:-$HOME/spectral-hohenberg-halperin-dynamics-2d}
case_dir=examples/05_order_parameter_relaxation
job_dir=$case_dir/kugui_jobs
work_base=${WORK_BASE:-/work/k0565/k056500/spectral-hohenberg-halperin-dynamics-2d/examples/05_order_parameter_relaxation/raw_data}
run_name=${RUN_NAME:-sine2d_grid256_L8192_dt4_T2400000}
output_root=$work_base/$run_name

samples=$((10#${SAMPLES:-16}))
sample_offset=$((10#${SAMPLE_OFFSET:-0}))
tasks_per_sample=$((10#${TASKS_PER_SAMPLE:-8}))
build_before_run=${BUILD_BEFORE_RUN:-0}

grid_x=${GRID_X:-256}
grid_y=${GRID_Y:-256}
length_x=${LENGTH_X:-8192}
length_y=${LENGTH_Y:-8192}
dt=${DT:-4.0}
run_time=${RUN_TIME:-2400000.0}
snapshot_dtout=${SNAPSHOT_DTOUT:-48000.0}
thermo_dtout=${THERMO_DTOUT:-120000.0}
eta=${ETA:-0.12}
mobility=${MOBILITY:-0.12}
zeta=${ZETA:-0.0}
kBT=${KBT:-1.0}
amplitude=${AMPLITUDE:-0.1}
nkx=${NKX:-1}
nky=${NKY:-1}

allocated_tasks=$(wc -l < "$PBS_NODEFILE")
active_tasks=$((samples * tasks_per_sample))
if [ "$samples" -le 0 ] || [ "$sample_offset" -lt 0 ] || [ "$tasks_per_sample" -le 0 ]; then
    echo "invalid sample layout: samples=$samples sample_offset=$sample_offset tasks_per_sample=$tasks_per_sample" >&2
    exit 1
fi
if [ "$active_tasks" -gt "$allocated_tasks" ]; then
    echo "active MPI tasks exceed allocation: $active_tasks > $allocated_tasks" >&2
    exit 1
fi

cd "$repo"
mkdir -p "$output_root"

if [ "$build_before_run" -ne 0 ]; then
    make -f Makefile.ohtaka -j 8
fi

python3 "$job_dir/prepare_kugui_inputs.py" \
    --output-root "$output_root" \
    --samples "$samples" \
    --sample-offset "$sample_offset" \
    --grid "$grid_x" "$grid_y" \
    --length "$length_x" "$length_y" \
    --dt "$dt" \
    --run-time "$run_time" \
    --snapshot-dtout "$snapshot_dtout" \
    --thermo-dtout "$thermo_dtout" \
    --eta "$eta" \
    --mobility "$mobility" \
    --zeta "$zeta" \
    --kBT "$kBT" \
    --order-parameter-amplitude "$amplitude" \
    --nkx "$nkx" \
    --nky "$nky"

hostfile_dir=$output_root/hostfiles
mkdir -p "$hostfile_dir"

pids=()
for local_sample in $(seq 0 $((samples - 1))); do
    sample=$((sample_offset + local_sample))
    sample_id=$(printf "%03d" "$sample")
    input=$output_root/runs/input_${sample_id}.script
    stdout=$output_root/logs/stdout_${sample_id}.log
    stderr=$output_root/logs/stderr_${sample_id}.log

    slot_start=$((local_sample * tasks_per_sample))
    slot_end=$((slot_start + tasks_per_sample - 1))
    line_start=$((slot_start + 1))
    line_end=$((slot_end + 1))
    hostfile=$hostfile_dir/hostfile_${sample_id}
    sed -n "${line_start},${line_end}p" "$PBS_NODEFILE" > "$hostfile"

    (
        export I_MPI_PIN_PROCESSOR_LIST=${slot_start}-${slot_end}
        echo "run sample ${sample_id}: ranks=${tasks_per_sample} pin=${I_MPI_PIN_PROCESSOR_LIST}"
        mpirun -np "$tasks_per_sample" -machinefile "$hostfile" \
            ./src/out.exe "$input" > "$stdout" 2> "$stderr"
    ) &
    pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
    wait "$pid" || status=1
done

exit "$status"
