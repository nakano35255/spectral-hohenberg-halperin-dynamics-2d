dimension           2
boundary            p p

grid                32 32
length              1024 1024
dealias             three_halves

order_parameters    1

timestep            4.0
time_evolution      srk3/incompressible

model free_energy   quadratic a[0] 1.0
model transport     constant eta 2.0 zeta 0.0 M[0,0] 2.0

fix                 1 order_parameter nonlinear on
fix                 2 momentum noise on seed 12345 kBT 1.0
fix                 3 order_parameter force/gradient on component 0 direction x amplitude 0.001953125

set                 density uniform value 1.0
set                 momentum all uniform value 0.0
set                 order_parameter all uniform value 0.0

thermo              observe on progress off nevery 100
restart             off

# Relax first. Measures are installed after this run, so budget/spectrum only
# observes the second segment.
run                 10000

measure             bs_shell budget/spectrum on component 0 nevery 20 nblock 200 file examples/04_ness_uniform_gradient/cascade/raw_data/budget_shell.dat mode shell average running
# measure             bs_2d budget/spectrum on component 0 nevery 50 nblock 250 file examples/04_ness_uniform_gradient/cascade/raw_data/budget_2d.dat mode 2d average running

run                 100000
